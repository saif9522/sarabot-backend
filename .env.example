PORT=4100
FRONTEND_URL=http://localhost:3100
# SQLite file, created in the prisma folder
DATABASE_URL="file:./chat.db"

# AI replies with Google Gemini (get a key at https://aistudio.google.com/apikey).
# Without a key, bots still answer with flows and the fallback message.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Alternative: ANTHROPIC_API_KEY=... with LLM_MODEL=claude-sonnet-5-5 (used only if GEMINI_API_KEY is empty)

# Where WhatsApp sessions are saved (one folder per number)
SESSION_DIR=./wa-sessions
# Seconds to wait for more messages before replying (customers often send several in a row)
REPLY_DEBOUNCE_SECONDS=3
# Safety limit: maximum bot replies to one contact per hour
MAX_BOT_REPLIES_PER_HOUR=30

# Uploaded images/documents for flows
UPLOAD_DIR=./uploads

# After a fallback / no-match reply, stay silent with that person for this many minutes
FALLBACK_COOLDOWN_MINUTES=60

# ---- Accounts and plans
# The first Super Admin is created from these on startup (password: 8+ characters).
# After the first start you can remove SUPERADMIN_PASSWORD from this file.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=
# Signs login sessions. Use a long random string (32+ characters).
SESSION_SECRET=
# Set to true when the site is served over https
COOKIE_SECURE=false

# ---- Sign-up and email
# Let businesses create their own account at /signup (true/false)
ALLOW_SIGNUP=true
# SMTP for "forgot password" emails. Without it, reset links are printed in this terminal.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SAIF Chat <no-reply@yourdomain.com>"
