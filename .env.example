PORT=4100
# In production: FRONTEND_URL=https://saschatbot.com
FRONTEND_URL=http://localhost:3100
# PostgreSQL — Supabase: Project → Connect → ORMs → Prisma shows both lines.
# DATABASE_URL: Transaction pooler (port 6543) with ?pgbouncer=true
# DIRECT_URL:   Session pooler (port 5432), used by migrations
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# AI replies with Google Gemini (get a key at https://aistudio.google.com/apikey).
# These can also be set by the Super Admin in Platform settings (that value wins).
# Without a key, bots still answer with flows and the fallback message.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Alternative: ANTHROPIC_API_KEY=... with LLM_MODEL=claude-sonnet-5-5 (used only if GEMINI_API_KEY is empty)

# Where WhatsApp sessions are saved (one folder per number)
SESSION_DIR=./wa-sessions
# Seconds to wait for more messages before replying (customers often send several in a row)
REPLY_DEBOUNCE_SECONDS=2
# Safety limit: maximum bot replies to one contact per hour
MAX_BOT_REPLIES_PER_HOUR=30

# Uploaded images/documents for flows
UPLOAD_DIR=./uploads

# After a fallback / no-match reply, stay silent with that person for this many minutes
FALLBACK_COOLDOWN_MINUTES=60

# ---- Accounts and plans
# The first Super Admin is created from these on startup (password: 8+ characters).
# After the first start you can remove SUPERADMIN_PASSWORD from this file.
SUPERADMIN_EMAIL=sbmgarhwa@gmail.com
SUPERADMIN_PASSWORD=
# REQUIRED on a live server. Signs logins and encrypts saved keys + WhatsApp logins.
# Generate one with:  openssl rand -hex 32   (never change it later, or numbers must be re-linked)
# The app refuses to start on Render / NODE_ENV=production without it.
SESSION_SECRET=
NODE_ENV=development
# Set to true when the site is served over https
COOKIE_SECURE=false

# ---- Sign-up and email
# Let businesses create their own account at /signup (true/false)
ALLOW_SIGNUP=true
# Demo/testing email account: sbmgarhwa@gmail.com (swap for a saschatbot.com address before launch).
# Sender shown on sign-in codes and password-reset emails:
MAIL_FROM_NAME="SAS Chatbot"
MAIL_FROM_EMAIL=sbmgarhwa@gmail.com

# Option A: Gmail SMTP (local machine, VPS, or paid hosting; Render's free tier blocks SMTP ports).
# SMTP_PASS must be a 16-letter Google App Password, not the normal Gmail password:
# Google Account -> Security -> 2-Step Verification (turn on) -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sbmgarhwa@gmail.com
SMTP_PASS=
SMTP_FROM="SAS Chatbot <sbmgarhwa@gmail.com>"

# Option B: Brevo HTTP API (works on Render free). Add sbmgarhwa@gmail.com as a verified sender in Brevo.
# When set, this is used instead of SMTP.
BREVO_API_KEY=
# Without A or B, emails are not sent; reset links and codes are printed in this terminal instead.

# ---- Razorpay (can also be set in Admin → Platform settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: Razorpay Dashboard → Webhooks → URL https://<your-backend>/api/payments/webhook
# events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=
